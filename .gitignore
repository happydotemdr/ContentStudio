# The downloaded corpus is for local inspection only — never commit it.
# Keeps the app repo clean (the raw texts are tens of MB).
output/
*.pyc
__pycache__/
.venv/

# Cowork plugin packaging — regenerated by scripts/build-cowork-plugin.sh
# from .claude/skills/ (the single source of truth). Never hand-edit these.
cowork-plugin/
dist/

# Pipeline app (local control app for the seven-skill pipeline)
runs/
pipeline-app/pipeline.db
pipeline-app/pipeline.db-wal
pipeline-app/pipeline.db-shm
pipeline-app/.venv/
pipeline-app/pipeline_app/__pycache__/
pipeline-app/pipeline_app/**/__pycache__/
pipeline-app/tests/__pycache__/
pipeline-app/pipeline_app.egg-info/
rgs-briefs/.superseded/

# Rendered Midjourney assets for each Short — large binaries, local only.
# Untracked but previously un-ignored, so a stray `git add .` would have committed them.
Generated Assets/

# YouTube session cookies for yt-dlp auth (live credentials -- never commit)
pipeline-app/cookies.txt

# YouTube Data API key (never commit)
pipeline-app/youtube_api_key.txt

# Resend API key for discovery email notifications (never commit)
pipeline-app/resend_api_key.txt

# Bright Data API key for Instagram discovery adapter (never commit)
pipeline-app/brightdata_api_key.txt
