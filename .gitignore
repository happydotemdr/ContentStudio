# The downloaded corpus is for local inspection only — never commit it.
# Keeps the app repo clean (the raw texts are tens of MB).
output/
*.pyc
__pycache__/
.venv/

# Cowork plugin packaging — regenerated by scripts/build-cowork-plugin.sh
# from .claude/skills/ (the single source of truth). Never hand-edit these.
cowork-plugin/
dist/

# Pipeline app (local control app for the seven-skill pipeline)
runs/
pipeline-app/pipeline.db
pipeline-app/pipeline.db-wal
pipeline-app/pipeline.db-shm
pipeline-app/.venv/
pipeline-app/pipeline_app/__pycache__/
pipeline-app/pipeline_app/**/__pycache__/
pipeline-app/tests/__pycache__/
pipeline-app/pipeline_app.egg-info/
rgs-briefs/.superseded/
pipeline-app/.uvicorn-local.log

# Rendered Midjourney assets for each Short — large binaries, local only.
# Untracked but previously un-ignored, so a stray `git add .` would have committed them.
Generated Assets/

# YouTube session cookies for yt-dlp auth (live credentials -- never commit)
pipeline-app/cookies.txt

# YouTube Data API key (never commit)
pipeline-app/youtube_api_key.txt

# Resend API key for discovery email notifications (never commit)
pipeline-app/resend_api_key.txt

# Bright Data API key for Instagram discovery adapter (never commit)
pipeline-app/brightdata_api_key.txt

# Automated asset stitcher workspaces — inputs, intermediates, and deliverables
renders/

# Overlay golden images — generated locally per-machine by test_overlays.py,
# not committed. Pillow's glyph rasterization varies across builds now that
# the dependency pins are floors (ruling R2/R3), so a committed golden would
# encode one machine's output and spuriously fail on another.
stitcher/tests/fixtures/goldens/

# Superpowers SDD scratch directory (temporary working files)
.superpowers/

# Coverage and pytest artifacts. pytest-cov became a standard dependency with
# finding F-74, so a coverage run now leaves these in every working tree; they
# were previously untracked noise a `git add -A` could sweep in (finding F-79).
# Both .coverage paths already exist untracked as of 2026-08-08.
.coverage
.coverage.*
pipeline-app/.coverage
htmlcov/
coverage.xml
.pytest_cache/

# Structured application logs written by pipeline_app/obs.py (P1's error-
# surfacing layer): one app-YYYY-MM-DD.log per day, local diagnostics only.
pipeline-app/logs/

# Freedom2BeU document-ingest app (converted output + own db -- real client
# names and private coaching-session content, must never land in git history)
Freedom2BeU/
doc-ingest-app/doc_ingest.db
doc-ingest-app/doc_ingest.db-wal
doc-ingest-app/doc_ingest.db-shm
doc-ingest-app/.venv/
doc-ingest-app/doc_ingest/__pycache__/
doc-ingest-app/doc_ingest/**/__pycache__/
doc-ingest-app/tests/__pycache__/
doc-ingest-app/doc_ingest_app.egg-info/
doc-ingest-app/client_secret.json
doc-ingest-app/token.json
doc-ingest-app/.coverage
